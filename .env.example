# OpenAI Zugangsdaten und Modell
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Optionale Einstellungen
OPENAI_TIMEOUT_SECONDS=30
OPENAI_MAX_RETRIES=2
MAX_TOOL_ROUNDS=5

# Erlaubte Frontend-Origins (kommagetrennt) fuer CORS
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Optional: Async-SQLAlchemy-URL fuer Persistenz (Chat-Historie, RAG, Auth).
# Ohne diese Variable startet die App weiterhin; DB-Funktionen sind dann deaktiviert.
# Beispiel Postgres: postgresql+asyncpg://postgres:postgres@localhost:5432/nova
DATABASE_URL=

# Optional: Authentifizierung (JWT). Ohne JWT_SECRET_KEY ist Auth deaktiviert.
# Erzeuge ein starkes Geheimnis, z. B. mit: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET_KEY=
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# RAG / Embeddings / Uploads
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIM=1536
RAG_TOP_K=4
MAX_UPLOAD_MB=10
UPLOAD_DIR=./data/uploads
